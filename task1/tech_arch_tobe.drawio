        <mxCell id="hx3T-EK2LzQMeHOv7K5d-41" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;container=0;" parent="hx3T-EK2LzQMeHOv7K5d-40" vertex="1">
