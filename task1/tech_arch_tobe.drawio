        <mxCell id="q8nEhcZvoaxTAeTDKcYH-19" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;container=0;" parent="q8nEhcZvoaxTAeTDKcYH-18" vertex="1">
