        <mxCell id="hx3T-EK2LzQMeHOv7K5d-42" value="&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:22.58px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;Kubernetes&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:22.58px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;cluster 1&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;vsdxID=7;fillColor=none;gradientColor=none;shape=stencil(nZBLDoAgDERP0z3SIyjew0SURgSD+Lu9kMZoXLhwN9O+tukAlrNpJg1SzDH4QW/URgNYgZTkjA4UkwJUgGXng+6DX1zLfmoymdXo17xh5zmRJ6Q42BWCfc2oJfdAr+Yv+AP9Cb7OJ3H/2JG1HNGz/84klThPVCc=);strokeColor=none;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;container=0;" parent="hx3T-EK2LzQMeHOv7K5d-40" vertex="1">
          <mxGeometry x="9.696969696969697" width="116.36363636363637" height="86.13999999999999" as="geometry" />
        </mxCell>
        <mxCell id="hx3T-EK2LzQMeHOv7K5d-44" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Архитектура промежуточная&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1. Добавляем n новых ЦОД&lt;br&gt;2. Создаём новые инстансы PostgreSQL на каждом из ЦОД&lt;br&gt;3. Настраиваем асинхронную репликацию для новых инстансов PostgreSQL&lt;br&gt;4. Выделяем всё так же один кластер для наших приложений внутри k8s&lt;br&gt;5. Добавляем HAProxy в каждый из ЦОД для автоматического перенаправления write/read операций между master и slave инстансами&lt;br&gt;6. При возможности, добавляем ещё repmgr, который даст возможность быстро переключиться на новый master. Опц., т.к. на первое время можно попробовать обойтись ручным переключением, благо, падения бд в проблемах не были описаны&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Промежуточная архитекутра даст возможность нормально функционировать всей системе, обеспечит бОльшую отказоустойчивость, позволит держать бОльную нагрузку на систему в целом. Однако, у неё есть недоработки, которые нужно будет исправить в целевом решении&lt;/p&gt;&lt;p&gt;Основной нюанс требующий отдельного внимания - задержка сети для клиентов из разных регионов. На данном этапе у нас нет никакого механизма, который бы позволял&amp;nbsp;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="-590" y="980" width="640" height="480" as="geometry" />
        </mxCell>
        <mxCell id="hx3T-EK2LzQMeHOv7K5d-64" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="760" y="1430" width="320" height="133.71" as="geometry" />
        </mxCell>
        <mxCell id="hx3T-EK2LzQMeHOv7K5d-65" style="vsdxID=6;fillColor=none;gradientColor=none;shape=stencil(vVNdD4IgFP01POIQms1nq//BEpVF4q6U9u/DoFJxPdjm2/04cO65cBDL2oo3AlHSGtAX0cncVIgdEKWyrgRIYyPEjohlhQZRgr7VucsbPiCH6Krvww29O0eGE5Q8XJaSaPcqnByWw9k2wWNZRFMHhzc+SlwhQHhATDxBj3kvWwzacCN1PSFXHEqBLRcuFC8nrbYTognKfjol65GSNIn28SL5SjGf2efL2UBMwO1nWykl3M1mzxJ8ib/eZHkrG8j47RMbfA1WSKWcP8f9uSFtyZmZHZ8=);strokeColor=#5282ff;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;container=0;" parent="hx3T-EK2LzQMeHOv7K5d-64" vertex="1">
